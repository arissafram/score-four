{
  "name": "score-four",
  "version": "1.0.0",
  "description": "3D Score Four (4×4×4 connect four) as a React component or a framework-free mount() function",
  "type": "module",
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/score-four.css"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp types/*.d.ts dist/",
    "test": "node --test"
  },
  "dependencies": {
    "three": "0.160.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.1.0",
    "vite": "^7.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arissafram/score-four.git"
  }
}
